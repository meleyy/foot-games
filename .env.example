WORLDCUP_API_KEY=replace_with_your_worldcup_api_key
WORLDCUP_API_LANG=fr
DATABASE_PATH=./data/foot-games.sqlite

# Optional delay between World Cup API requests (milliseconds).
API_REQUEST_DELAY_MS=200

# EA Drop API (https://drop-api.ea.com/rating/ea-sports-fc)
EA_REQUEST_DELAY_MS=100
EA_SQUAD_SIZE=26
# EA_ENRICH_ONLY=true
# EA_NATIONS=France,Argentina,Brazil,England,Germany,Spain
# EA_ALL_NATIONS=true

# ESPN squads (no API key)
ESPN_REQUEST_DELAY_MS=150

# SoFIFA API - often blocked by Cloudflare
SOFIFA_API_TOKEN=replace_with_your_sofifa_api_token
SOFIFA_REQUEST_DELAY_MS=1100
# SOFIFA_ROSTER=250016
